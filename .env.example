# آدرس API در حالت production (اگر با Nginx روی همان دامنه سرو می‌شود خالی بگذارید و /api را پراکسی کنید)
VITE_API_BASE=/api

# آدرس تایل نقشه (پیش‌فرض OpenStreetMap). اگر در ایران باز نمی‌شود، سرور تایل دیگری بگذارید
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# آدرس فایل نقشه‌ی آفلاین (پیش‌فرض /tiles/zanjan.pmtiles)
# VITE_PMTILES_URL=/tiles/zanjan.pmtiles
